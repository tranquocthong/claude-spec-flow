#!/bin/sh
# Charter §0b #8 — engine hard ceiling 3000 LOC. DEV-TIME ONLY (not shipped with the plugin).
# One-time per clone:  git config core.hooksPath .githooks
CAP=3000; WARN=2700; engine="bin/flow-tools.cjs"
[ -f "$engine" ] || exit 0
loc=$(wc -l < "$engine" | tr -d ' ')
if [ "$loc" -ge "$CAP" ]; then
  echo "BLOCKED: $engine = $loc/$CAP LOC — engine FROZEN (charter §0b #8)."
  echo "Stable-use: add NO new engine code; only delete/consolidate down to commit."
  exit 1
fi
[ "$loc" -ge "$WARN" ] && echo "WARN: $engine = $loc/$CAP LOC — approaching cap; consolidate/delete before adding."
exit 0
